    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-04-01T13:32:40.158822487Z\",\n",
    "     \"start_time\": \"2026-04-01T13:32:39.700381866Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from __future__ import annotations\\n\",\n",
    "    \"\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"from collections import defaultdict\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"from tensorboard.backend.event_processing.event_accumulator import EventAccumulator\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def load_event_accumulator(path: str | Path) -> EventAccumulator:\\n\",\n",
    "    \"    ea = EventAccumulator(str(path), size_guidance={\\\"scalars\\\": 0})\\n\",\n",
    "    \"    ea.Reload()\\n\",\n",
    "    \"    return ea\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def load_all_scalars(path: str | Path) -> dict[str, pd.DataFrame]:\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Load all scalar tags from one TensorBoard logdir or event file.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        {\\n\",\n",
    "    \"            tag_name: DataFrame(step, value)\\n\",\n",
    "    \"        }\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    ea = load_event_accumulator(path)\\n\",\n",
    "    \"    tags = ea.Tags().get(\\\"scalars\\\", [])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    out: dict[str, pd.DataFrame] = {}\\n\",\n",
    "    \"    for tag in tags:\\n\",\n",
    "    \"        events = ea.Scalars(tag)\\n\",\n",
    "    \"        out[tag] = pd.DataFrame(\\n\",\n",
    "    \"            {\\n\",\n",
    "    \"                \\\"step\\\": [e.step for e in events],\\n\",\n",
    "    \"                \\\"value\\\": [e.value for e in events],\\n\",\n",
    "    \"            }\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"    return out\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def aggregate_all_tags(paths: list[str | Path]) -> dict[str, pd.DataFrame]:\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Aggregate all scalar tags across multiple TensorBoard runs.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    For each tag:\\n\",\n",
    "    \"      - outer-join on step across all runs\\n\",\n",
    "    \"      - compute mean, std, and n across seeds\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        {\\n\",\n",
    "    \"            tag_name: DataFrame(step, seed_0, seed_1, ..., mean, std, n)\\n\",\n",
    "    \"        }\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    tag_to_seed_dfs: dict[str, list[pd.DataFrame]] = defaultdict(list)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Collect all tags from all paths\\n\",\n",
    "    \"    for seed_idx, path in enumerate(paths):\\n\",\n",
    "    \"        tag_map = load_all_scalars(path)\\n\",\n",
    "    \"        for tag, df in tag_map.items():\\n\",\n",
    "    \"            df = df.rename(columns={\\\"value\\\": f\\\"seed_{seed_idx}\\\"})\\n\",\n",
    "    \"            tag_to_seed_dfs[tag].append(df)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    aggregated: dict[str, pd.DataFrame] = {}\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for tag, dfs in tag_to_seed_dfs.items():\\n\",\n",
    "    \"        merged: pd.DataFrame | None = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for df in dfs:\\n\",\n",
    "    \"            merged = df if merged is None else merged.merge(df, on=\\\"step\\\", how=\\\"outer\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        assert merged is not None\\n\",\n",
    "    \"        merged = merged.sort_values(\\\"step\\\").reset_index(drop=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        seed_cols = [c for c in merged.columns if c.startswith(\\\"seed_\\\")]\\n\",\n",
    "    \"        merged[\\\"mean\\\"] = merged[seed_cols].mean(axis=1, skipna=True)\\n\",\n",
    "    \"        merged[\\\"std\\\"] = merged[seed_cols].std(axis=1, ddof=1, skipna=True)\\n\",\n",
    "    \"        merged[\\\"n\\\"] = merged[seed_cols].notna().sum(axis=1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        aggregated[tag] = merged\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return aggregated\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def aggregate_last_value_all_tags(paths: list[str | Path]) -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    For each scalar tag, take the last logged value from each path and compute mean/std across paths.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns one summary row per tag.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    rows = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for seed_idx, path in enumerate(paths):\\n\",\n",
    "    \"        tag_map = load_all_scalars(path)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for tag, df in tag_map.items():\\n\",\n",
    "    \"            if df.empty:\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"            last_row = df.sort_values(\\\"step\\\").iloc[-1]\\n\",\n",
    "    \"            rows.append(\\n\",\n",
    "    \"                {\\n\",\n",
    "    \"                    \\\"tag\\\": tag,\\n\",\n",
    "    \"                    \\\"seed\\\": seed_idx,\\n\",\n",
    "    \"                    \\\"step\\\": int(last_row[\\\"step\\\"]),\\n\",\n",
    "    \"                    \\\"value\\\": float(last_row[\\\"value\\\"]),\\n\",\n",
    "    \"                    \\\"path\\\": str(path),\\n\",\n",
    "    \"                }\\n\",\n",
    "    \"            )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    all_last = pd.DataFrame(rows)\\n\",\n",
    "    \"    if all_last.empty:\\n\",\n",
    "    \"        return all_last\\n\",\n",
    "    \"\\n\",\n",
    "    \"    summary = (\\n\",\n",
    "    \"        all_last.groupby(\\\"tag\\\", as_index=False)\\n\",\n",
    "    \"        .agg(\\n\",\n",
    "    \"            mean=(\\\"value\\\", \\\"mean\\\"),\\n\",\n",
    "    \"            std=(\\\"value\\\", \\\"std\\\"),\\n\",\n",
    "    \"            n=(\\\"value\\\", \\\"count\\\"),\\n\",\n",
    "    \"            min_step=(\\\"step\\\", \\\"min\\\"),\\n\",\n",
    "    \"            max_step=(\\\"step\\\", \\\"max\\\"),\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        .sort_values(\\\"tag\\\")\\n\",\n",
    "    \"        .reset_index(drop=True)\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    return summary\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Example usage\\n\",\n",
    "    \"paths = [\\n\",\n",
    "    \"    \\\"/home/jacopo/PycharmProjects/progetto-tesi/main/model/script/outputs/TEST-BEST/2026-04-01_10-37-32/tb_logs/FINAL-TEST-NOFUSE150/version_0/events.out.tfevents.1775032765.jacopo-MS-7C91.590453.4\\\",\\n\",\n",
    "    \"    \\\"/home/jacopo/PycharmProjects/progetto-tesi/main/model/script/outputs/TEST-BEST/2026-04-01_10-32-29/tb_logs/FINAL-TEST-NOFUSE42/version_0/events.out.tfevents.1775032465.jacopo-MS-7C91.589804.4\\\",\\n\",\n",
    "    \"    \\\"/home/jacopo/PycharmProjects/progetto-tesi/main/model/script/outputs/TEST-BEST/2026-04-01_10-26-30/tb_logs/FINAL-TEST-NOFUSE1/version_0/events.out.tfevents.1775032103.jacopo-MS-7C91.589045.4\\\",\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Full curves for every tag\\n\",\n",
    "    \"all_curves = aggregate_all_tags(paths)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Example: inspect one tag\\n\",\n",
    "    \"print(all_curves[\\\"test/fused/mrr_mean\\\"].head())\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Final per-tag summary using last logged point from each seed\\n\",\n",
    "    \"summary = aggregate_last_value_all_tags(paths)\\n\",\n",
    "    \"print(summary)\"\n",
    "   ],\n",
