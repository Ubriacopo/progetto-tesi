    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"from tensorboard.backend.event_processing.event_accumulator import EventAccumulator\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def load_scalar_series(path: str | Path, tag: str) -> pd.DataFrame:\\n\",\n",
    "    \"    ea = EventAccumulator(str(path), size_guidance={\\\"scalars\\\": 0})\\n\",\n",
    "    \"    ea.Reload()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    tags = ea.Tags().get(\\\"scalars\\\", [])\\n\",\n",
    "    \"    if tag not in tags:\\n\",\n",
    "    \"        raise ValueError(f\\\"Tag '{tag}' not found in {path}. Available: {tags}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    events = ea.Scalars(tag)\\n\",\n",
    "    \"    df = pd.DataFrame(\\n\",\n",
    "    \"        {\\n\",\n",
    "    \"            \\\"step\\\": [e.step for e in events],\\n\",\n",
    "    \"            \\\"value\\\": [e.value for e in events],\\n\",\n",
    "    \"        }\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    return df\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def aggregate_seeds(paths: list[str | Path], tag: str) -> pd.DataFrame:\\n\",\n",
    "    \"    merged = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i, path in enumerate(paths):\\n\",\n",
    "    \"        df = load_scalar_series(path, tag).rename(columns={\\\"value\\\": f\\\"seed_{i}\\\"})\\n\",\n",
    "    \"        merged = df if merged is None else merged.merge(df, on=\\\"step\\\", how=\\\"outer\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    merged = merged.sort_values(\\\"step\\\").reset_index(drop=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    seed_cols = [c for c in merged.columns if c.startswith(\\\"seed_\\\")]\\n\",\n",
    "    \"    merged[\\\"mean\\\"] = merged[seed_cols].mean(axis=1, skipna=True)\\n\",\n",
    "    \"    merged[\\\"std\\\"] = merged[seed_cols].std(axis=1, ddof=1, skipna=True)\\n\",\n",
    "    \"    merged[\\\"n\\\"] = merged[seed_cols].notna().sum(axis=1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return merged\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# example\\n\",\n",
    "    \"paths = [\\n\",\n",
    "    \"    \\\"/home/jacopo/PycharmProjects/progetto-tesi/main/model/script/outputs/TEST-BEST/2026-04-01_10-37-32/tb_logs/FINAL-TEST-NOFUSE150/version_0/events.out.tfevents.1775032765.jacopo-MS-7C91.590453.4\\\",\\n\",\n",
    "    \"    \\\"/home/jacopo/PycharmProjects/progetto-tesi/main/model/script/outputs/TEST-BEST/2026-04-01_10-32-29/tb_logs/FINAL-TEST-NOFUSE42/version_0/events.out.tfevents.1775032465.jacopo-MS-7C91.589804.4\\\",\\n\",\n",
    "    \"    \\\"/home/jacopo/PycharmProjects/progetto-tesi/main/model/script/outputs/TEST-BEST/2026-04-01_10-26-30/tb_logs/FINAL-TEST-NOFUSE1/version_0/events.out.tfevents.1775032103.jacopo-MS-7C91.589045.4\\\",\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"df = aggregate_seeds(paths, tag=\\\"test/fused/mrr_eeg\\\")\\n\",\n",
    "    \"print(df.head())\"\n",
    "   ],\n",
